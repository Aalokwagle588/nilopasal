NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname
SESSION_COOKIE_NAME=__Host-nilopasal_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=true
CORS_ORIGINS=https://nilopasal.com,https://www.nilopasal.com,https://api.nilopasal.com
SECRET_KEY=generate-a-strong-random-secret-key
